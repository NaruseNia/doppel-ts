{
  "name": "@doppel-ts/native",
  "version": "0.1.2",
  "license": "MIT OR Apache-2.0",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "napi build --release --platform",
    "build:debug": "napi build --platform",
    "test": "cargo test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3"
  },
  "optionalDependencies": {
    "@doppel-ts/native-darwin-arm64": "0.1.2",
    "@doppel-ts/native-darwin-x64": "0.1.2",
    "@doppel-ts/native-linux-x64-gnu": "0.1.2",
    "@doppel-ts/native-win32-x64-msvc": "0.1.2"
  },
  "napi": {
    "binaryName": "doppel-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
